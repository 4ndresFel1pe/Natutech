# Copie este archivo como .env y llene los valores. El archivo .env nunca se sube al repositorio.
# En la Entrega 2 no hace falta: el prototipo y el servidor simulado no usan variables.

# Puerto en el que escucha la API (Entrega 3)
PUERTO=3000

# Conexión a PostgreSQL, con la forma postgres://USUARIO:CONTRASENA@SERVIDOR:5432/BASE
DATABASE_URL=

# Secreto para firmar los tokens JWT. Genere uno con: openssl rand -hex 32
JWT_SECRETO=

# Cuánto dura una sesión (8h = una jornada del vivero)
JWT_EXPIRA_EN=8h

# Número de WhatsApp del vivero, con indicativo 57 y sin espacios ni signos
WHATSAPP_NUMERO=
