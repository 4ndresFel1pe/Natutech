# Copie este archivo como .env y llene los valores:   cp .env.example .env
# .env nunca se sube al repositorio (está en .gitignore). Aquí solo van los nombres
# de las variables y valores de ejemplo que no sirven en producción.

# ---- Base de datos (servicio db de docker-compose.yml) ----
# Use solo letras, números y guiones en la contraseña: va dentro de una URL.
POSTGRES_USER=natutech
POSTGRES_PASSWORD=
POSTGRES_DB=natutech

# Conexión para correr la API o las pruebas fuera de Docker (npm run dev, npm test),
# con la base de Compose encendida (docker compose up -d db). Dentro de Compose la
# API arma su propia conexión con los tres valores de arriba.
# Ejemplo: postgres://natutech:SU_CONTRASEÑA@localhost:5432/natutech
DATABASE_URL=

# ---- API ----
# Puerto de la API fuera de Docker (npm run dev).
PUERTO=3000

# Secreto para firmar los tokens JWT (mínimo 32 caracteres). Genere uno con:
#   openssl rand -hex 32
JWT_SECRETO=

# Cuánto dura una sesión (8h = una jornada del vivero).
JWT_EXPIRA_EN=8h

# Orígenes del navegador que pueden llamar a la API, separados por comas.
CORS_ORIGENES=http://localhost:8080,http://127.0.0.1:8080

# "si" carga el catálogo de ejemplo (web/datos/ejemplo.json) cuando la base está vacía.
SEMBRAR_DATOS_EJEMPLO=si

# Cada cuántas horas se recalculan las alertas de reabastecimiento.
HORAS_ENTRE_ALERTAS=6

# Administrador inicial: se crea solo la primera vez, cuando no hay ningún usuario.
# La contraseña debe tener entre 8 y 72 caracteres.
ADMIN_NOMBRE=Administración del vivero
ADMIN_CORREO=
ADMIN_CONTRASENA=

# ---- Puertos del computador (opcionales) ----
# WEB_PUERTO=8080
# DB_PUERTO_LOCAL=5432

# ---- Entrega 4 ----
# Número de WhatsApp de los botones del catálogo: indicativo 57 y el celular, solo dígitos
# (por ejemplo 573001234567). El número real va solo en .env. Vacío: número de ejemplo.
WHATSAPP_NUMERO=

# Pagos en línea con Wompi (decisión D17). Opcionales: sin ellos el cobro en línea queda
# apagado. Se copian del panel de comercios de Wompi (Desarrollo > Programadores). Las
# llaves pub_test_ son del ambiente de pruebas: no mueven dinero real.
WOMPI_LLAVE_PUBLICA=
WOMPI_SECRETO_INTEGRIDAD=
WOMPI_SECRETO_EVENTOS=
# Dirección pública del sitio, para que Wompi devuelva al cliente a pago-resultado.html.
# En el servidor la pone docker-compose.prod.yml a partir de DOMINIO.
# URL_PUBLICA=http://localhost:8080

# ---- Servidor en la nube (Entrega 4, ver docs/despliegue.md) ----
# Solo en el servidor. Dominio público: Caddy pide el certificado HTTPS para él y para www.
DOMINIO=
# Solo en el servidor. Hace que "docker compose" use también docker-compose.prod.yml.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
