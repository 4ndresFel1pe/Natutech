{
  "name": "natutech-servidor",
  "version": "0.3.0",
  "description": "API de Natutech para el Vivero Las Acacias: implementa api/openapi.yaml",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node src/servidor.js",
    "dev": "node --watch --env-file-if-exists=../.env src/servidor.js",
    "migrar": "node --env-file-if-exists=../.env scripts/migrar.js",
    "sembrar": "node --env-file-if-exists=../.env scripts/sembrar.js",
    "crear-usuario": "node --env-file-if-exists=../.env scripts/crear-usuario.js",
    "test": "node --env-file-if-exists=../.env --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "pg": "^8.23.1",
    "yaml": "^2.9.1"
  }
}
