# Servidor web del conjunto (servicio "web" de docker-compose.yml).
# - Sirve el prototipo (carpeta web/) en http://localhost:8080
# - Reenvía todo lo que empiece por /api/ a la API (servicio "api", puerto 3000).
# - Publica /configuracion.json con el número de WhatsApp del vivero (decisión D17).
#
# Es una plantilla: al arrancar, la imagen oficial de nginx reemplaza ${WHATSAPP_NUMERO}
# por el valor de la variable de entorno (sale del .env) y guarda el resultado en
# /etc/nginx/conf.d/default.conf. Solo se reemplazan variables de entorno que existen,
# así que las de nginx ($host, $uri...) quedan intactas.
# Como el navegador ve un solo origen, el prototipo llama a "/api/..." sin CORS y la
# API no se publica directamente en ningún puerto del computador (decisión D13).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;
    server_tokens off;
    # Redirecciones y Location relativas: nginx no conoce el puerto del computador
    # (8080 por defecto), así que no debe escribir URL absolutas.
    absolute_redirect off;

    # Cabeceras de seguridad para las páginas del prototipo.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location /api/ {
        # La barra final quita el prefijo: /api/productos llega a la API como /productos.
        proxy_pass http://api:3000/;
        # La API responde Location: /productos/{id}; aquí se convierte en /api/productos/{id}.
        proxy_redirect / /api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 100k;
    }

    # Configuración pública del prototipo. El número real de WhatsApp vive solo en el .env
    # (WHATSAPP_NUMERO) y nunca se escribe en el repositorio. Si está vacío, el prototipo
    # usa el número de ejemplo. "expires -1" evita que el navegador guarde una copia vieja.
    location = /configuracion.json {
        default_type application/json;
        expires -1;
        return 200 '{"whatsapp":"${WHATSAPP_NUMERO}"}';
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
